# ─── Сервер ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
HOST="0.0.0.0"
PORT="3000"

# Адрес витрины — используется в письмах/ссылках и как дефолтный origin
APP_URL="http://localhost:5173"

# Домены, которым разрешён доступ к API. Список через запятую: витрина + админка.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# ─── База данных ──────────────────────────────────────────────────────────────
# Локально — из backend/docker-compose.yml. На Railway — внутренний хост *.railway.internal
DATABASE_URL="postgresql://zagatovky:zagatovky@localhost:5433/zagatovky"

# ─── Авторизация админки ──────────────────────────────────────────────────────
# В проде сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-please"
JWT_REFRESH_TTL="30d"

# Учётка владельца, создаваемая сидом
SEED_OWNER_EMAIL="owner@zagatovky.kz"
SEED_OWNER_PASSWORD="zagatovky123"

# ─── Cloudflare R2 (хранение фото) ────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Публичный домен бакета: Cloudflare → R2 → бакет → Settings → Public access.
# Вид: https://pub-<хеш>.r2.dev или свой домен. Это НЕ адрес *.r2.cloudflarestorage.com —
# по нему файлы отдаются только с подписью запроса. Без переменной загрузка фото отключена,
# остальное API работает — удобно на старте разработки.
R2_PUBLIC_URL=""
